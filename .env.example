# Rename this file to ".env" and add your real OpenRouter API key.
# Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Model slugs on OpenRouter (see https://openrouter.ai/models)
CHAT_MODEL=google/gemini-flash-latest
IMAGE_MODEL=google/gemini-2.5-flash-image

# Optional but recommended by OpenRouter (used for app attribution/rankings)
SITE_URL=https://example.com
APP_TITLE=AI Chat & Image Generator
